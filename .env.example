DATABASE_URL="postgresql://USER:PASS@HOST:5432/sc_mobility?schema=public"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_publishable_key_here"
CLERK_SECRET_KEY="sk_live_your_secret_key_here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk settings
#  - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY: clave pública (cliente). Debe empezar por "pk_".
#  - CLERK_SECRET_KEY: clave secreta (servidor). Debe empezar por "sk_".
#  Crea una aplicación en https://dashboard.clerk.com y copia las keys aquí.

# Optional / recommended
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Instrucciones rápidas:
# 1) Local: copia este archivo a .env y rellena los valores:
#      cp .env.example .env
#    No subas el archivo .env al repositorio.
# 2) Vercel: añade las mismas variables en Settings → Environment Variables del proyecto.
#    - Marca CLERK_SECRET_KEY como "Secret".
#    - Usa NEXT_PUBLIC_APP_URL con la URL de producción (ej. https://mi-app.vercel.app).
# 3) Desarrollo: `npm run dev`.
# 4) Build/Producción: asegúrate de que Vercel tiene las variables y despliega.
